        <!-- Branch 4: Tìm kiếm, Sắp xếp & Thống kê -->
        <mxCell id="act_stats" parent="act_1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="Chức năng 7, 8, 9:&#xa;- Tìm kiếm (Mã, Tên, Còn hạn, Basic/Premium)&#xa;- Sắp xếp (Mã, Tên, Ngày hết hạn, Ngày ĐK)&#xa;- Báo cáo doanh thu thực tế qua Transactions" vertex="1">
          <mxGeometry height="70" width="240" x="870" y="440" as="geometry" />
        </mxCell>

        <!-- Branch 0: Thoát chương trình -->
