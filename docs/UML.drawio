  <!-- TAB 2: ACTIVITY DIAGRAM / MENU FLOW -->
  <diagram name="Activity Diagram - Menu Flow" id="activity_diagram_tab">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="act_0" />
        <mxCell id="act_1" parent="act_0" />

        <!-- Start Node -->
        <mxCell id="act_start" parent="act_1" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1">
          <mxGeometry height="30" width="30" x="685" y="40" as="geometry" />
        </mxCell>

        <!-- Action: Khởi tạo & Tải JSON -->
        <mxCell id="act_load" parent="act_1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" value="Khởi tạo GymManager&#xa;&amp; Tự động nạp dữ liệu từ 'gym_data.json'" vertex="1">
          <mxGeometry height="50" width="250" x="575" y="110" as="geometry" />
        </mxCell>
        <mxCell id="edge_start_load" edge="1" parent="act_1" source="act_start" target="act_load" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Action: Hiển thị Menu Console -->
        <mxCell id="act_menu" parent="act_1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" value="Hiển thị Menu Console chính (Lựa chọn 0 - 10)&#xa;&amp; Tiếp nhận lựa chọn người dùng" vertex="1">
          <mxGeometry height="55" width="280" x="560" y="200" as="geometry" />
        </mxCell>
        <mxCell id="edge_load_menu" edge="1" parent="act_1" source="act_load" target="act_menu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decision Diamond: Điều hướng Menu -->
        <mxCell id="act_decision" parent="act_1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" value="Lựa chọn&#xa;người dùng?" vertex="1">
          <mxGeometry height="80" width="120" x="640" y="295" as="geometry" />
        </mxCell>
        <mxCell id="edge_menu_dec" edge="1" parent="act_1" source="act_menu" target="act_decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Branch 1: Quản lý Hội viên (CRUD) -->
        <mxCell id="act_crud" parent="act_1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="Chức năng 1, 2, 3, 4:&#xa;Xem / Thêm (Basic/Premium) / Sửa / Xóa&#xa;- Tính phí đa hình (calculate_membership_fee)&#xa;- Tự động ghi nhận Transaction đăng ký mới" vertex="1">
          <mxGeometry height="70" width="240" x="80" y="440" as="geometry" />
        </mxCell>

        <!-- Branch 2: Gia hạn thẻ -->
        <mxCell id="act_renew" parent="act_1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="Chức năng 5: Gia hạn gói tập&#xa;- Kiểm tra: Còn hạn -&amp;gt; cộng dồn ngày&#xa;- Hết hạn -&amp;gt; tính từ ngày hiện tại&#xa;- Tạo Transaction gia hạn &amp; cộng doanh thu" vertex="1">
          <mxGeometry height="70" width="230" x="350" y="440" as="geometry" />
        </mxCell>

        <!-- Branch 3: Điểm danh Check-in -->
        <mxCell id="act_checkin" parent="act_1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="Chức năng 6: Điểm danh / Check-in&#xa;- Kiểm tra trạng thái is_active()&#xa;- Nếu hết hạn -&amp;gt; Báo lỗi, yêu cầu gia hạn&#xa;- Nếu còn hạn -&amp;gt; Tạo WorkoutSession" vertex="1">
          <mxGeometry height="70" width="230" x="610" y="440" as="geometry" />
