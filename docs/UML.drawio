        <mxCell id="edge_d_checkin" edge="1" parent="act_1" source="act_decision" target="act_checkin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;">
